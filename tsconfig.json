{
  "compilerOptions": {
    // Set explicitly rather than inherited: TS 5.x defaulted strict off and
    // TS 6+ defaults it on, so relying on the default silently changes what
    // the build enforces across a compiler upgrade.
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES6",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
