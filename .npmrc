# Release-age gate: never resolve a package version younger than 3 days
# (npm lets authors unpublish for 72 hours). Lockfile installs (npm ci) are
# unaffected. For a vetted zero-day patch, exempt that one package with a
# min-release-age-exclude[]=<pkg> line (always with []: two plain lines with the
# same key keep only the last), with the advisory and date beside it.
# No auth tokens in this file: they belong in ~/.npmrc or NODE_AUTH_TOKEN.
min-release-age=3
